# Copy this file to application.properties (same folder) and fill in real values.
# application.properties is gitignored on purpose — never commit real credentials.
# In a deployed environment, set these as environment variables instead of editing
# the file directly (Spring reads ${VAR_NAME} from the process environment).

spring.datasource.url=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
spring.datasource.username=YOUR_SUPABASE_DB_USER
spring.datasource.password=YOUR_SUPABASE_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.open-in-view=true
server.port=8080

# Flyway owns schema changes now — see src/main/resources/db/migration. Add a new
# V<next>__description.sql file for any schema change; never edit an applied one.
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# Generate a fresh random secret per environment — never reuse this across dev/prod,
# and never commit the real value. E.g.: openssl rand -hex 32
jwt.secret=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
jwt.expiration=86400000

# Email (Gmail SMTP) — use a Gmail App Password, not your real account password
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-gmail@gmail.com
spring.mail.password=your-16-char-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to "*" (any origin) when unset — fine for local dev, tighten for prod.
app.cors.allowed-origins=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:3000

# Set to true only in a private/local debugging environment — it puts full exception
# details (stack class, message, root cause) into HTTP error responses.
app.expose-error-details=false
